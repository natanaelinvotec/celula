rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function temPerfil() { return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function ativo() { return logado() && temPerfil() && perfil().ativo != false; }
    function admin() { return ativo() && perfil().papel == 'admin'; }
    function emailAdmin() { return logado() && request.auth.token.email != null
      && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/app).data.admins; }

    // ---- configuração ----
    match /config/app { allow read: if logado(); allow write: if admin(); }
    match /config/contadores {
      allow read: if ativo();
      // só incremento de 1 no contador de orçamentos
      allow create: if ativo() && request.resource.data.keys().hasOnly(['orcamento']) && request.resource.data.orcamento == 1;
      allow update: if (ativo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orcamento'])
                    && request.resource.data.orcamento == resource.data.orcamento + 1) || admin(); // gestão pode reiniciar a numeração
    }

    // ---- catálogo: leitura para logados, escrita só admin ----
    match /convenios/{id} { allow read: if logado(); allow write: if admin(); }
    match /exames/{id}    { allow read: if logado(); allow write: if admin(); }
    match /precos_manuais/{id} { allow read: if logado(); allow write: if admin(); }
    match /auditoria/{id} { allow read: if admin(); allow create: if admin(); allow update, delete: if false; }
    match /importacoes/{id} { allow read: if admin(); allow create: if admin(); allow update, delete: if false; }

    // ---- aprendizado da IA ----
    match /apelidos/{id} {
      allow read: if logado();
      allow create: if ativo() && request.resource.data.keys().hasAll(['texto', 'textoNorm', 'mnemonico', 'origem', 'confirmacoes', 'criadoEm'])
                    && request.resource.data.texto is string && request.resource.data.texto.size() <= 200
                    && request.resource.data.textoNorm is string && request.resource.data.textoNorm.size() <= 200
                    && request.resource.data.mnemonico is string && request.resource.data.mnemonico.size() <= 30
                    && request.resource.data.origem in ['recepcao', 'ia', 'aprovacao', 'catalogo', 'guia_db']
                    && request.resource.data.confirmacoes is int && request.resource.data.confirmacoes >= 1;
      allow update: if admin() || (ativo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmacoes', 'mnemonico', 'unidade', 'atualizadoEm', 'origem', 'texto'])
                    && request.resource.data.confirmacoes is int && request.resource.data.confirmacoes >= resource.data.confirmacoes);
      allow delete: if admin();
    }

    // ---- grupos de pedido (termo do pedido → vários exames) ----
    match /grupos/{id} {
      allow read: if logado();
      allow create, update: if ativo() && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 80
                    && request.resource.data.termos is list && request.resource.data.termos.size() <= 30
                    && request.resource.data.mnemonicos is list && request.resource.data.mnemonicos.size() >= 1 && request.resource.data.mnemonicos.size() <= 40;
      allow delete: if admin();
    }

    // ---- usuários ----
    match /usuarios/{uid} {
      allow read: if logado();
      // primeiro acesso: o próprio usuário cria seu perfil (admin só se o e-mail estiver em config/app.admins)
      allow create: if (logado() && request.auth.uid == uid
                        && request.resource.data.papel == (emailAdmin() ? 'admin' : 'atendente')
                        && request.resource.data.ativo == true) || admin();
      // o próprio: nome, foto, último acesso · admin: tudo
      allow update: if (logado() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'fotoBase64', 'ultimoAcesso', 'atualizadoEm', 'status', 'statusEm', 'ultimoPing'])) || admin();
      allow delete: if false;
    }

    // ---- solicitações (fila de conferência) ----
    match /solicitacoes/{id} {
      allow read: if ativo();
      allow create: if ativo() && request.resource.data.status == 'pendente' && request.resource.data.atendenteUid == request.auth.uid
                    && request.resource.data.textoLido is string && request.resource.data.textoLido.size() <= 300;
      allow update: if admin();
      allow delete: if false;
    }

    // ---- orçamentos ----
    match /orcamentos/{id} {
      allow read: if ativo();
      allow create: if ativo() && request.resource.data.atendenteUid == request.auth.uid
                    && request.resource.data.itens is list && request.resource.data.itens.size() <= 150
                    && request.resource.data.total is number && request.resource.data.total >= 0
                    && request.resource.data.status in ['rascunho', 'gravado', 'enviado', 'aguardando_conferencia', 'convertido', 'perdido'];
      // qualquer atendente ativa pode atualizar (a coleta pode acontecer em outra unidade); admin também.
      // A dona do orçamento (ou a gestão) pode transferir para outra atendente (muda atendenteUid).
      allow update: if ativo()
                    && request.resource.data.status in ['rascunho', 'gravado', 'enviado', 'aguardando_conferencia', 'convertido', 'perdido']
                    && (request.resource.data.atendenteUid == resource.data.atendenteUid || request.auth.uid == resource.data.atendenteUid || admin())
                    && request.resource.data.numero == resource.data.numero;
      // só a gestão exclui
      allow delete: if admin();
    }

    // ---- pré-cadastro do paciente (página pública pre.html, sem login) ----
    // O paciente só grava se apresentar o token que está impresso no QR/link do orçamento (orcamentos/{id}.preToken).
    match /precadastros/{orcId} {
      allow read: if ativo();
      allow create, update: if request.resource.data.token is string && request.resource.data.token.size() >= 8
                    && request.resource.data.token == get(/databases/$(database)/documents/orcamentos/$(orcId)).data.preToken
                    && request.resource.data.keys().hasOnly(['token', 'nome', 'cpf', 'nascimento', 'telefone', 'lgpd', 'enviadoEm', 'orcamentoNumero', 'visto'])
                    && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 120
                    && request.resource.data.cpf is string && request.resource.data.cpf.size() == 11
                    && request.resource.data.nascimento is string && request.resource.data.nascimento.size() == 10
                    && request.resource.data.telefone is string && request.resource.data.telefone.size() >= 10 && request.resource.data.telefone.size() <= 13
                    && request.resource.data.lgpd == true;
      // recepção marca como visto
      allow update: if ativo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visto', 'vistoPor', 'vistoEm']);
      allow delete: if admin();
    }

    // ---- Atendimento WhatsApp (conversas). Entrada real é gravada pelo servidor (conta de serviço, fora das regras);
    //      o simulador de testes (admin) grava no mesmo formato. Atendentes só mudam status/atribuição/leitura/orçamento. ----
    match /wa_conversas/{tel} {
      allow read: if ativo();
      allow create, delete: if admin();
      allow update: if admin() || (ativo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'atendenteUid', 'atendenteNome', 'naoLidas', 'orcamentoId', 'orcamentoNumero', 'motivo', 'encerradaEm', 'encerradaPor', 'atualizadoEm', 'ultimaMsg', 'ultimaEm', 'ultimaDirecao', 'primeiraRespostaEm', 'npsPendente'])
                    && request.resource.data.status in ['fila', 'aberta', 'aguardando', 'encerrada']);
      match /mensagens/{mid} {
        allow read: if ativo();
        allow create: if admin() || (ativo() && request.resource.data.direcao in ['saida', 'nota', 'sistema'] && request.resource.data.autorUid == request.auth.uid
                      && (!('texto' in request.resource.data) || (request.resource.data.texto is string && request.resource.data.texto.size() <= 4096)));
        allow update, delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
